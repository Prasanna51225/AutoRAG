# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Embedding
EMBEDDING_CACHE_TTL=3600

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CUTOFF=100

# Reflexion
MAX_LOOPS=2
CRITIC_THRESHOLD=0.3

# Retrieval
HYBRID_ALPHA=0.6
DYNAMIC_TOPK=true

# Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=256

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=AutoRAG

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000